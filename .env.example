APP_NAME=Booksy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.railway.app

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=8080
REVERB_SCHEME=https

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Booksy

# Error-report emails on HTTP 500 (comma-separated recipients).
# Only sent in the listed environments; add "local" to test locally.
ERROR_REPORT_EMAIL=info@glowrez.com
ERROR_REPORT_ENVS=production
# ERROR_REPORT_ENABLED=true
# ERROR_REPORT_THROTTLE=10

# Pre-launch leads (/welcome → /for-business → /join, managed in /owner/leads)
# Inbox(es) that get an email for every new lead — comma-separated. Empty = no email.
LEADS_NOTIFICATION_EMAIL=
# GlowRez's public WhatsApp number, international digits only (e.g. 9639XXXXXXXX). Empty = WhatsApp buttons hidden.
LEADS_WHATSAPP_NUMBER=
# Full Instagram profile URL. Empty = Instagram links hidden.
LEADS_INSTAGRAM_URL=
# true = show the 3-way gateway on "/" for first-time visitors (default false: "/" stays the marketplace).
LEADS_GATEWAY_ON_ROOT=false
